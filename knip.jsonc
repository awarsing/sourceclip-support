{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Generated by modules/widget-preload/module.ts as a Nitro virtual module.
  "ignoreUnresolved": ["#widget-preload/hints"],
  "ignoreDependencies": [
    // #internal/nuxt/paths is a Nitro virtual alias that resolves into this package.
    "@nuxt/nitro-server",
    // Virtual module generated by @nuxthub/core.
    "@nuxthub/blob",
    // NuxtHub blob drivers load these at runtime (Vercel Blob and S3-compatible).
    "@vercel/blob",
    "aws4fetch",
    // Icon collection read by @nuxt/icon at build time.
    "@iconify-json/lucide"
  ],
  "entry": [
    // @nuxtjs/tailwindcss loads its stylesheet from this conventional path.
    "app/assets/css/tailwind.css",
    // Cloudflare build stubs, aliased in nuxt.config.ts.
    "server/lib/agent/pg-native-unavailable.cjs",
    "server/lib/inbox/vercel-queue-unavailable.ts"
  ]
}
