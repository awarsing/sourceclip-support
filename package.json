{
  "name": "feedlog",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": "12.4.1"
  },
  "scripts": {
    "agent:prompt": "node --import tsx scripts/preview-agent-prompt.ts",
    "agent:search-eval": "node --env-file=.env --import tsx scripts/evaluate-agent-help-search.ts",
    "agent:test": "node --env-file=.env --import tsx --test tests/agent-*.test.ts",
    "build": "NODE_OPTIONS=\"--max-old-space-size=4096 $NODE_OPTIONS\" nuxt build && mkdir -p .output/server/db && cp -r server/db/migrations .output/server/db/migrations",
    "build:cf": "NITRO_PRESET=cloudflare-module NODE_OPTIONS=\"$NODE_OPTIONS --max-old-space-size=8192\" pnpm build",
    "check": "node ${TTM_PLATFORM_ROOT:-../..}/local-quality/repo-quality.mjs --mode fast",
    "deploy:cf": "wrangler deploy --cwd .output",
    "dev": "nuxt dev",
    "fallow:audit": "node ${TTM_PLATFORM_ROOT:-../..}/local-quality/fallow-audit.mjs",
    "format": "node ${TTM_PLATFORM_ROOT:-../..}/local-quality/run-tool.mjs biome format --write .",
    "format:check": "node ${TTM_PLATFORM_ROOT:-../..}/local-quality/run-tool.mjs biome format . && git diff --check",
    "generate": "nuxt generate",
    "generate:auth": "pnpm dlx auth@latest generate",
    "generate:migration": "drizzle-kit generate",
    "i18n:check": "node scripts/i18n-check.mjs",
    "knip:strict": "node ${TTM_PLATFORM_ROOT:-../..}/local-quality/run-tool.mjs knip",
    "lint": "node ${TTM_PLATFORM_ROOT:-../..}/local-quality/run-tool.mjs biome lint --error-on-warnings .",
    "migrate": "drizzle-kit migrate",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "quality": "node ${TTM_PLATFORM_ROOT:-../..}/local-quality/repo-quality.mjs --mode full",
    "quality:repo": "pnpm run i18n:check && pnpm run test:runtime",
    "test": "rm -rf coverage && NODE_V8_COVERAGE=coverage/v8 node scripts/with-test-postgres.mjs node --enable-source-maps --import tsx --test tests/*.test.ts",
    "test:runtime": "node scripts/with-test-postgres.mjs node --test tests/inbox-node-runtime.test.mjs",
    "type-check": "nuxt prepare && node ${TTM_PLATFORM_ROOT:-../..}/local-quality/run-tool.mjs vue-tsc -b --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.69",
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@mastra/ai-sdk": "1.10.3",
    "@mastra/core": "1.67.0",
    "@mastra/memory": "1.30.0",
    "@mastra/pg": "1.25.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/hints": "1.0.0-alpha.10",
    "@nuxt/icon": "2.2.1",
    "@nuxt/image": "2.0.0",
    "@nuxthub/core": "0.10.7",
    "@nuxtjs/i18n": "10.2.4",
    "@nuxtjs/seo": "3.4.0",
    "@pinia/nuxt": "0.11.3",
    "@vercel/blob": "^2.8.1",
    "@vercel/queue": "^0.7.0",
    "@vueuse/core": "^14.4.0",
    "ai": "7.0.105",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "image-meta": "0.2.2",
    "jose": "^6.2.12",
    "lucide-vue-next": "^0.577.0",
    "md-editor-v3": "^6.5.6",
    "nanoid": "^5.1.16",
    "nuxt": "4.5.2",
    "openai": "^6.49.0",
    "pg": "8.23.0",
    "pgvector": "^0.2.1",
    "pinyinlite": "^1.2.1",
    "postgres": "^3.4.9",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "2.4.3",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.7.0",
    "uuidv7": "^1.2.1",
    "vue-sonner": "^2.0.9",
    "vuedraggable": "^4.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@iconify-json/lucide": "^1.2.141",
    "@nuxt/kit": "4.5.2",
    "@nuxtjs/tailwindcss": "7.0.0-beta.1",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "h3": "1.15.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "cloudflare": {
    "bindings": {
      "POSTGRES": {
        "description": "Hyperdrive config that accelerates your Postgres connection. Create one or pick an existing config. Needs a Postgres URL with the `vector` extension enabled (Neon and Supabase both support it)."
      },
      "BLOB": {
        "description": "R2 bucket for uploaded files (images on feedback posts). Create a new bucket or pick an existing one. Skipping this disables file uploads but the app still works."
      }
    }
  }
}
